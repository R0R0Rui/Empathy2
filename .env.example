# Emotion classifier.
EMPATHY_EMOTION_MODEL_DIR=models/goemotions-production
EMPATHY_EMOTION_MAX_LENGTH=512
# Hugging Face source for the GoEmotions classifier (used when files are missing locally).
EMPATHY_EMOTION_MODEL_REPO=JamieYCR/goemotions-chatbot-emotion-classifier
EMPATHY_EMOTION_MODEL_REVISION=main
# Auto-download missing model files on app startup (set to false to require manual download).
EMPATHY_AUTO_DOWNLOAD_MODELS=true

# Empathy LLM: Unsloth 4-bit Qwen2.5 base plus your Hugging Face PEFT LoRA adapter.
EMPATHY_LLM_BASE_MODEL=unsloth/Qwen2.5-7B-Instruct-bnb-4bit
EMPATHY_LLM_ADAPTER_MODEL=JamieYCR/qwen25-7b-empathy
EMPATHY_MAX_NEW_TOKENS=260
EMPATHY_TEMPERATURE=0.7
EMPATHY_TOP_P=0.9

# Conversation/session memory.
EMPATHY_HISTORY_LIMIT=10
EMPATHY_MAX_TURNS_PER_SESSION=80
